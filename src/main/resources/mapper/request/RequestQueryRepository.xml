<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mybatis.generalTest.request.repository.RequestQueryRepository">

    <select id="findOne" parameterType="RequestId" resultType="RequestResponseDto">
        SELECT
            ID,
            TITLE,
            CONTENTS,
            TEST_TYPE AS TYPE,
            REQUEST_DATE,
            REQUESTER_ID,
            STATUS
        FROM MYBATIS_REQUEST
        WHERE ID = #{id}
    </select>

    <select id="findAll" parameterType="RequestCondition" resultType="RequestResponseDto">
        SELECT
            ID,
            TITLE,
            CONTENTS,
            TEST_TYPE AS TYPE,
            REQUEST_DATE,
            REQUESTER_ID,
            STATUS
        FROM MYBATIS_REQUEST
    </select>
</mapper>